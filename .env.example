# ===== 数据库 =====
# 存储类型：sqlite（默认，MVP 验证）| postgres（部署阶段启用）
DB_TYPE=sqlite
# SQLite 文件路径（相对进程 cwd）；:memory: 可用于测试
DB_PATH=./data/reggov.db
# Postgres 连接串（DB_TYPE=postgres 时必填）
DATABASE_URL=

# ===== 服务 =====
# 监听主机：0.0.0.0 允许容器/外部访问；纯本地开发可改 127.0.0.1
HOST=0.0.0.0
PORT=3000
# 调度时区：每日 08:00 Asia/Shanghai 触发
TZ=Asia/Shanghai

# ===== 采集调度 =====
# 自动采集总开关（true/false）。默认关闭：在配置好 LLM Key 并显式开启前，
# 调度器不会注册/启动定时采集，避免无 LLM 时整站栏目页污染数据库。
# 部署到 Cloud Studio 时设为 true。
COLLECTION_ENABLED=false
# 是否启用定时采集（true/false）。关闭后仅手动触发 / 启动采集
CRON_ENABLED=true
# 采集 cron 表达式（默认每日 08:00）；高频可设 "0 */6 * * *"
COLLECT_CRON=0 8 * * *
# 服务启动时是否立即跑一次采集（true/false）
RUN_ON_START=false

# ===== 采集校验 =====
# 近期窗口天数：只采集近 N 天发布的条目（防历史回灌）。默认 90 天。
COLLECT_RECENT_DAYS=90

# ===== 自 ping 保活（防 Cloud Studio 休眠）=====
# 是否开启自 ping 保活（默认 true）
KEEPALIVE_ENABLED=true
# 自 ping 间隔毫秒（默认 300000 = 5 分钟）
KEEPALIVE_INTERVAL_MS=300000

# ===== LLM 分类器（可选）=====
# 不填 LLM_API_KEY → 走规则分类器（完全可运行，无外部调用）。
# 填了 API Key   → 启用 LLM 增强分类（语义标签 + 生成式摘要 + 英文→中文翻译）。
#
# 推荐先以规则分类器上线，Key 到位后填入 .env 重启即切 qwen-plus。
# 国内免费 LLM（用户选定：通义千问 qwen-plus — 每月100万token免费、数据不出境、OpenAI 兼容）
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 其他国内厂商（取消注释并替换上面的取值即可；无需 Key 时整段留空）：
# LLM_PROVIDER=glm
# LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
#
# 海外 OpenAI（原生 json_schema 结构化输出）：
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=

# ===== 鉴权（预留，默认关闭免登录）=====
AUTH_ENABLED=false

# ===== NMPA 栏目 URL（逗号分隔，覆盖默认；留空用常量默认值）=====
# 说明：NMPA 采集以英文镜像 english.nmpa.gov.cn 为主路径（无 WAF），
#       以下中文栏目作为 WAF 失败时的降级备选源。
# 例：https://www.cde.org.cn/main/guide/approvalNews,https://www.cmde.org.cn/CL0004/
NMPA_COLUMNS=
